# Copy to fabric-config/.env — Fabric reads this file from its config dir.
# Any Fabric-supported vendor works; the workflow only needs a model that
# handles ~30k-token transcripts. Gemini 2.5 Pro is what this was built on.
DEFAULT_VENDOR=Gemini
DEFAULT_MODEL=gemini-2.5-pro
GEMINI_API_KEY=

# Alternatives (set one vendor's key and matching DEFAULT_VENDOR/DEFAULT_MODEL):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
