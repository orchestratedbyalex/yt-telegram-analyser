# Copy to .env and fill in. Never commit .env.

# --- Required -------------------------------------------------------------
# Telegram bot token from @BotFather (step 1 in the README).
# Used by yt-research to live-edit the "researching…" message. The n8n
# workflow uses the same token, entered once as an n8n credential (step 7).
TELEGRAM_BOT_TOKEN=

# --- Optional: transcript fallback -----------------------------------------
# https://www.searchapi.io — free tier is 100 requests/month. Only used when
# YouTube blocks the direct caption fetch ("confirm you're not a bot").
SEARCHAPI_KEY=

# --- Optional: research commands (/verify, /roadmap) ------------------------
# Model and reasoning effort passed to `codex exec`. Any model your Codex
# login is allowed to use.
CODEX_MODEL=gpt-5.4
CODEX_REASONING_EFFORT=medium
# Hard cap on one research run. The n8n "HTTP: Call yt-research" node timeout
# (660 s) must stay above this.
CODEX_TIMEOUT_S=600

# --- Only if you use the bundled n8n (docker compose --profile n8n) --------
# Telegram must be able to reach n8n over public HTTPS for the webhook.
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=UTC
